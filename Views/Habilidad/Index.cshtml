@model IEnumerable<DevPath.Models.Habilidad>

@{
    ViewData["Title"] = "Habilidades";
}

<h2>Mis Habilidades</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Nueva Habilidad</a>
</p>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Título</th>
            <th>Área</th>
            <th>Nivel</th>
            <th>Estado</th>
            <th>Progreso</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Titulo</td>
                <td>@item.Area?.Nombre</td>
                <td>@item.Nivel</td>
                <td>
                    @{
                        var badgeClass = item.Estado switch
                        {
                            "Completado" => "bg-success",
                            "En progreso" => "bg-warning text-dark",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @badgeClass">@item.Estado</span>
                </td>
                <td style="width: 180px;">
                    <div class="progress" style="height: 18px;">
                        <div class="progress-bar bg-info" role="progressbar"
                             style="width: @item.PorcentajeProgreso%;"
                             aria-valuenow="@item.PorcentajeProgreso" aria-valuemin="0" aria-valuemax="100">
                            @item.PorcentajeProgreso%
                        </div>
                    </div>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>