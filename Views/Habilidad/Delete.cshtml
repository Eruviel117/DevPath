@model DevPath.Models.Habilidad

@{
    ViewData["Title"] = "Eliminar Habilidad";
}

<h2>Eliminar Habilidad</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white fw-bold">
                ⚠️ ¿Seguro que quieres eliminar esta habilidad?
            </div>
            <div class="card-body">
                <p class="text-muted">
                    Esta acción no se puede deshacer.
                    @if (Model.Recursos.Any() || Model.Registros.Any())
                    {
                        <strong>
                            Se eliminarán también sus @Model.Recursos.Count
                            recurso(s) y @Model.Registros.Count registro(s)
                            de avance.
                        </strong>
                    }
                </p>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Título</dt>
                    <dd class="col-sm-8">@Model.Titulo</dd>

                    <dt class="col-sm-4">Nivel</dt>
                    <dd class="col-sm-8">@Model.Nivel</dd>

                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">@Model.Estado</dd>

                    <dt class="col-sm-4">Área</dt>
                    <dd class="col-sm-8">@Model.Area?.Nombre</dd>
                </dl>
            </div>
            <div class="card-footer bg-white">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <input type="submit" value="Sí, eliminar" class="btn btn-danger" />
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
