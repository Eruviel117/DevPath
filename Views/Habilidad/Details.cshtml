@model DevPath.Models.Habilidad

@{
    ViewData["Title"] = "Detalle de Habilidad";
    var nivelColor = ViewData["NivelColor"]?.ToString() ?? "#002060";
}

<h2>@Model.Titulo</h2>
<hr />

<div class="row g-4">

    <!-- Información principal -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header text-white fw-bold"
                 style="background-color: #002060;">
                <i class="bi bi-info-circle"></i> Información general
            </div>
            <div class="card-body">

                <div class="mb-3">
                    <label class="text-muted small">Área</label>
                    <p class="fw-bold mb-0">@Model.Area?.Nombre</p>
                </div>

                <div class="mb-3">
                    <label class="text-muted small">Descripción</label>
                    <p class="mb-0">
                        @(string.IsNullOrEmpty(Model.Descripcion)
                            ? "Sin descripción" : Model.Descripcion)
                    </p>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Nivel</label>
                        <p class="mb-0">
                            <span class="badge"
                                  style="background-color: @nivelColor;">
                                @Model.Nivel
                            </span>
                        </p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Estado</label>
                        <p class="mb-0">
                            @{
                                var badgeClass = Model.Estado switch
                                {
                                    "Completado" => "bg-success",
                                    "En progreso" => "bg-warning text-dark",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@Model.Estado</span>
                        </p>
                    </div>
                </div>

                <!-- Barra de progreso -->
                <div class="mb-3">
                    <label class="text-muted small">Progreso de recursos</label>
                    <div class="progress mt-1" style="height: 20px;">
                        <div class="progress-bar bg-info" role="progressbar"
                             style="width: @Model.PorcentajeProgreso%;"
                             aria-valuenow="@Model.PorcentajeProgreso"
                             aria-valuemin="0" aria-valuemax="100">
                            @Model.PorcentajeProgreso%
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Panel de estrategia (patrón Strategy) -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100"
             style="border-left: 5px solid @nivelColor !important;">
            <div class="card-header fw-bold text-white"
                 style="background-color: @nivelColor;">
                <i class="bi bi-lightning-charge"></i> Info del nivel — @Model.Nivel
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    @ViewData["NivelDescripcion"]
                </p>
                <hr />
                <p class="mb-1 small text-muted">Recursos recomendados:</p>
                <p class="fw-bold fs-4 mb-0"
                   style="color: @nivelColor;">
                    @ViewData["NivelRecursos"]
                </p>
                <p class="text-muted small">
                    Tienes @Model.Recursos.Count recurso(s) vinculado(s).
                </p>
            </div>
        </div>
    </div>

</div>

<!-- Recursos vinculados -->
<div class="mt-4">
    <h5 class="fw-bold" style="color: #002060;">
        <i class="bi bi-journal-bookmark"></i> Recursos vinculados
    </h5>
    @if (!Model.Recursos.Any())
    {
        <p class="text-muted">
            No hay recursos vinculados todavía.
            <a asp-controller="Recurso" asp-action="Create">Agregar uno</a>.
        </p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>URL</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var recurso in Model.Recursos)
                    {
                        <tr>
                            <td>@recurso.Nombre</td>
                            <td>
                                <span class="badge bg-secondary">
                                    @recurso.Tipo
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(recurso.Url))
                                {
                                    <a href="@recurso.Url" target="_blank">
                                        Ver recurso
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Sin URL</span>
                                }
                            </td>
                            <td>
                                @if (recurso.Completado)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i> Completado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Pendiente
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Registros de avance -->
<div class="mt-4">
    <h5 class="fw-bold" style="color: #002060;">
        <i class="bi bi-clipboard-check"></i> Registros de avance
    </h5>
    @if (!Model.Registros.Any())
    {
        <p class="text-muted">
            No hay registros todavía.
            <a asp-controller="Registro" asp-action="Create">
                Agregar una nota
            </a>.
        </p>
    }
    else
    {
        @foreach (var registro in Model.Registros)
        {
            <div class="card border-0 shadow-sm mb-2">
                <div class="card-body">
                    <p class="mb-1">@registro.Nota</p>
                    <small class="text-muted">
                        @registro.Fecha.ToString("dd/MM/yyyy HH:mm")
                    </small>
                </div>
            </div>
        }
    }
</div>

<!-- Botones -->
<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.Id"
       class="btn btn-primary">Editar</a>
    <a asp-action="Index"
       class="btn btn-secondary">Volver a la lista</a>
</div>