@model DevPath.Models.Registro

@{
    ViewData["Title"] = "Nuevo Registro";
}

<h2>Nuevo Registro de Avance</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Nota" class="form-label"></label>
                <textarea asp-for="Nota" class="form-control"
                          rows="4"
                          placeholder="¿Qué aprendiste hoy?"></textarea>
                <span asp-validation-for="Nota" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Fecha" class="form-label"></label>
                <input asp-for="Fecha" class="form-control"
                       type="datetime-local" />
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HabilidadId" class="form-label"></label>
                <select asp-for="HabilidadId" class="form-select"
                        asp-items="ViewBag.HabilidadId">
                    <option value="">-- Selecciona una habilidad --</option>
                </select>
                <span asp-validation-for="HabilidadId" class="text-danger"></span>
            </div>

            <div class="mt-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}