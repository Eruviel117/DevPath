@model DevPath.Models.Registro

@{
    ViewData["Title"] = "Eliminar Registro";
}

<h2>Eliminar Registro</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white fw-bold">
                ⚠️ ¿Seguro que quieres eliminar este registro?
            </div>
            <div class="card-body">
                <p class="text-muted">Esta acción no se puede deshacer.</p>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Nota</dt>
                    <dd class="col-sm-8">@Model.Nota</dd>

                    <dt class="col-sm-4">Fecha</dt>
                    <dd class="col-sm-8">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Habilidad</dt>
                    <dd class="col-sm-8">@Model.Habilidad?.Titulo</dd>
                </dl>
            </div>
            <div class="card-footer bg-white">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <input type="submit" value="Sí, eliminar" class="btn btn-danger" />
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
