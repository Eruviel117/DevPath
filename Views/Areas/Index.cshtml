@model IEnumerable<DevPath.Models.Area>

@{
    ViewData["Title"] = "Áreas";
}

<h2>Mis Áreas</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Nueva Área</a>
</p>

@if (!Model.Any())
{
    <div class="devpath-empty">
        <div class="devpath-empty-icon"><i class="bi bi-folder2-open"></i></div>
        <p class="devpath-empty-title">Todavía no tienes áreas creadas</p>
        <p class="devpath-empty-text">Las áreas te ayudan a organizar tus habilidades por tema.</p>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Crea tu primera área
        </a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm"
                     style="border-left: 5px solid @item.Color !important;">
                    <div class="card-header fw-bold"
                         style="background-color: @item.Color;
                        color: white;
                        text-shadow: 0px 1px 2px rgba(0,0,0,0.4);">
                        @item.Nombre
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(item.Descripcion))
                        {
                            <p class="card-text text-muted">@item.Descripcion</p>
                        }
                        else
                        {
                            <p class="card-text text-muted fst-italic">
                                Sin descripción
                            </p>
                        }
                        <p class="card-text">
                            <small class="text-muted">
                                 @item.Habilidades.Count habilidades
                            </small>
                        </p>
                    </div>
                    <div class="card-footer bg-white border-0">
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-secondary">Ver</a>
                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </div>
                </div>
            </div>
        }
    </div>
}