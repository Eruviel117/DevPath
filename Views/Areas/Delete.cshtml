@model DevPath.Models.Area

@{
    ViewData["Title"] = "Eliminar Área";
}

<h2>Eliminar Área</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white fw-bold">
                ⚠️ ¿Seguro que quieres eliminar esta área?
            </div>
            <div class="card-body">
                <p class="text-muted">
                    Esta acción no se puede deshacer.
                    @if (Model.Habilidades.Any())
                    {
                        <strong>
                            Se eliminarán también las @Model.Habilidades.Count
                            habilidad(es) que pertenecen a esta área.
                        </strong>
                    }
                </p>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8">@Model.Nombre</dd>

                    <dt class="col-sm-4">Descripción</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrEmpty(Model.Descripcion) ? "Sin descripción" : Model.Descripcion)
                    </dd>

                    <dt class="col-sm-4">Color</dt>
                    <dd class="col-sm-8">
                        <span class="badge" style="background-color: @Model.Color;">
                            @Model.Color
                        </span>
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-white">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <input type="submit" value="Sí, eliminar" class="btn btn-danger" />
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
