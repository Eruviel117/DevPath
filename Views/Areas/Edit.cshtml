@model DevPath.Models.Area

@{
    ViewData["Title"] = "Editar Área";
}

<h2>Editar Área</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Color" class="form-label"></label>
                <div class="d-flex align-items-center gap-2">
                    <input asp-for="Color" type="color" class="form-control form-control-color"
                           title="Elige un color para identificar esta área" />
                    <span class="text-muted small">
                        Este color identifica el área en el dashboard y las listas.
                    </span>
                </div>
                <span asp-validation-for="Color" class="text-danger"></span>
            </div>

            <div class="mt-3">
                <input type="submit" value="Guardar cambios" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
