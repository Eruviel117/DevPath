@model DevPath.Models.Area

@{
    ViewData["Title"] = "Nueva Área";
}

<h2>Nueva Área</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control"
                          rows="3"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Color" class="form-label"></label>
                <div class="d-flex gap-2 align-items-center">
                    <input asp-for="Color" class="form-control"
                           type="color" style="width: 60px; height: 40px;
                    padding: 2px;" />
                    <input type="text" id="colorText"
                           class="form-control"
                           value="#00B0F0"
                           oninput="document.getElementById('Color').value=this.value" />
                </div>
                <span asp-validation-for="Color" class="text-danger"></span>
            </div>

            <div class="mt-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}