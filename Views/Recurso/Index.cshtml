@model IEnumerable<DevPath.Models.Recurso>

@{
    ViewData["Title"] = "Recursos";
}

<h2>Mis Recursos</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo Recurso</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Todavía no hay recursos registrados.
        <a asp-action="Create">Agrega tu primer recurso</a>.
    </div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Habilidad</th>
                <th>Tipo</th>
                <th>URL</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Habilidad?.Titulo</td>
                    <td>
                        <span class="badge bg-secondary">@item.Tipo</span>
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.Url))
                        {
                            <a href="@item.Url" target="_blank">
                                Ver recurso 🔗
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">Sin URL</span>
                        }
                    </td>
                    <td>
                        @if (item.Completado)
                        {
                            <span class="badge bg-success">Completado ✅</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pendiente</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-secondary">Ver</a>
                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}