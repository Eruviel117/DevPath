@model DevPath.Models.Recurso

@{
    ViewData["Title"] = "Detalle del Recurso";
}

<h2>@Model.Nombre</h2>
<hr />

<div class="row g-4">

    <!-- Información principal -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header text-white fw-bold"
                 style="background-color: #002060;">
                Información del recurso
            </div>
            <div class="card-body">

                <div class="mb-3">
                    <label class="text-muted small">Tipo</label>
                    <p class="mb-0">
                        <span class="badge bg-secondary fs-6">
                            @Model.Tipo
                        </span>
                    </p>
                </div>

                <div class="mb-3">
                    <label class="text-muted small">URL</label>
                    <p class="mb-0">
                        @if (!string.IsNullOrEmpty(Model.Url))
                        {
                            <a href="@Model.Url" target="_blank"
                               class="btn btn-outline-primary btn-sm">
                                🔗 Abrir recurso
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">Sin URL registrada</span>
                        }
                    </p>
                </div>

                <div class="mb-3">
                    <label class="text-muted small">Habilidad vinculada</label>
                    <p class="mb-0">
                        <a asp-controller="Habilidad"
                           asp-action="Details"
                           asp-route-id="@Model.HabilidadId"
                           class="fw-bold">
                            @Model.Habilidad?.Titulo
                        </a>
                    </p>
                </div>

                <div class="mb-3">
                    <label class="text-muted small">Estado</label>
                    <p class="mb-0">
                        @if (Model.Completado)
                        {
                            <span class="badge bg-success fs-6">
                                ✅ Completado
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">
                                ⏳ Pendiente
                            </span>
                        }
                    </p>
                </div>

            </div>
        </div>
    </div>

    <!-- Panel lateral -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100"
             style="border-left: 5px solid #00B0F0 !important;">
            <div class="card-header fw-bold text-white"
                 style="background-color: #00B0F0;">
                💡 Acerca de este recurso
            </div>
            <div class="card-body">
                @{
                    var tipoDescripcion = Model.Tipo switch
                    {
                        "Curso" => "Material estructurado con lecciones progresivas.",
                        "Video" => "Contenido audiovisual para aprendizaje visual.",
                        "Libro" => "Lectura profunda sobre el tema.",
                        "Artículo" => "Lectura corta con información específica.",
                        _ => "Recurso de apoyo para el aprendizaje."
                    };
                }
                <p class="text-muted small">@tipoDescripcion</p>
                <hr />
                @if (Model.Completado)
                {
                    <p class="text-success small fw-bold">
                        ✅ Ya completaste este recurso.
                    </p>
                }
                else
                {
                    <p class="text-muted small">
                        ⏳ Todavía no has completado este recurso.
                        Márcalo como completado cuando termines.
                    </p>
                    <a asp-action="Edit" asp-route-id="@Model.Id"
                       class="btn btn-sm btn-outline-success w-100">
                        Marcar como completado
                    </a>
                }
            </div>
        </div>
    </div>

</div>

<!-- Botones -->
<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.Id"
       class="btn btn-primary">Editar</a>
    <a asp-controller="Habilidad"
       asp-action="Details"
       asp-route-id="@Model.HabilidadId"
       class="btn btn-outline-secondary">
        Volver a la Habilidad
    </a>
    <a asp-action="Index"
       class="btn btn-secondary">Volver a Recursos</a>
</div>