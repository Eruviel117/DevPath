<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DevPath</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DevPath.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="devpath-shell">

        <!-- Sidebar (escritorio) -->
        <aside class="devpath-sidebar d-none d-md-flex flex-column">
            @await Html.PartialAsync("_Sidebar")
        </aside>

        <!-- Sidebar (móvil, se abre como panel lateral) -->
        <div class="offcanvas offcanvas-start d-md-none devpath-sidebar-offcanvas" tabindex="-1" id="devpathSidebarOffcanvas">
            <div class="offcanvas-header">
                <span class="fw-bold devpath-brand-text">DevPath</span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
            </div>
            <div class="offcanvas-body p-0 d-flex flex-column">
                @await Html.PartialAsync("_Sidebar")
            </div>
        </div>

        <div class="devpath-content">
            <!-- Barra superior solo en móvil -->
            <div class="devpath-mobile-topbar d-md-none">
                <button class="btn btn-outline-secondary btn-sm" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#devpathSidebarOffcanvas"
                        aria-controls="devpathSidebarOffcanvas">
                    ☰
                </button>
                <span class="fw-bold" style="color:#002060;">DevPath</span>
            </div>

            <main role="main" class="devpath-main">
                @RenderBody()
            </main>

            <footer class="devpath-footer text-muted">
                &copy; 2026 - DevPath - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
