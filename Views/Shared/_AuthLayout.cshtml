<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DevPath</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DevPath.styles.css" asp-append-version="true" />
</head>
<body class="devpath-auth-body">
    <div class="devpath-auth-wrapper">
        <a asp-controller="Home" asp-action="Index" class="devpath-auth-brand text-decoration-none">
            <span class="devpath-logo-badge"><i class="bi bi-diagram-3"></i></span>
            <span>DevPath</span>
        </a>

        <main role="main">
            @RenderBody()
        </main>

        <p class="devpath-auth-footer text-center">
            &copy; 2026 - DevPath - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </p>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
